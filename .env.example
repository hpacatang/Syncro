APP_NAME=Syncro
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_TIMEZONE=UTC
APP_DISPLAY_TIMEZONE=Asia/Manila

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=420
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

FILESYSTEM_DISK=public

# Optional AI draft providers. Add credentials only to your local .env.
# OPEN_AI_KEY=
# OPENAI_MODEL=gpt-5.4-mini
# GEMINI_KEY=
# GEMINI_MODEL=gemini-3.8-flash
# DEEPSEEK_KEY=
# DEEPSEEK_MODEL=deepseek-flash
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen3:8b
# OLLAMA_TIMEOUT=300

# Optional Meta Page publishing. Never commit live credentials.
# META_ACCESS_TOKEN=
# META_PAGE_ID=
# META_PAGE_NAME=USJR
# META_GRAPH_API_VERSION=v23.0

# Optional Supabase Storage configuration; local development uses FILESYSTEM_DISK=public.
# FILESYSTEM_DISK=supabase
# SUPABASE_S3_KEY=
# SUPABASE_S3_SECRET=
# SUPABASE_S3_REGION=
# SUPABASE_BUCKET=
# SUPABASE_S3_ENDPOINT=
# SUPABASE_PUBLIC_BASE_URL=
